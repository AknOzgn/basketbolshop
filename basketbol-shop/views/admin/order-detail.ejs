<!DOCTYPE html>
<html lang="tr">
<head><title>Sipariş <%= order.order_no %> | Admin</title><%- include('../partials/head') %></head>
<body class="admin-body">
  <div class="admin-layout">
    <%- include('_sidebar') %>
    <main class="admin-main">
      <h1>Sipariş: <%= order.order_no %></h1>

      <div class="order-detail-grid">
        <div>
          <h3>Müşteri Bilgileri</h3>
          <p><%= order.customer_name %></p>
          <p><%= order.email %></p>
          <p><%= order.phone %></p>
          <p><%= order.address %>, <%= order.city %></p>
        </div>
        <div>
          <h3>Sipariş Bilgisi</h3>
          <p>Ödeme Yöntemi: <%= order.payment_method === 'havale' ? 'Havale/EFT' : 'Kredi Kartı' %></p>
          <p>Tarih: <%= new Date(order.created_at).toLocaleString('tr-TR') %></p>
          <p>Toplam: <strong><%= order.total.toFixed(2) %> ₺</strong></p>

          <form action="/admin/siparisler/<%= order.id %>/durum" method="post" class="status-form">
            <label>Durum:
              <select name="status">
                <% ['Beklemede (Havale/EFT)','Ödeme Bekleniyor','Ödendi','Hazırlanıyor','Kargoya Verildi','Teslim Edildi','İptal Edildi','Ödeme Başarısız'].forEach(s => { %>
                  <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </label>
            <button type="submit" class="btn btn-primary">Durumu Güncelle</button>
          </form>
        </div>
      </div>

      <h3>Ürünler</h3>
      <table class="admin-table">
        <thead><tr><th>Ürün</th><th>Adet</th><th>Birim Fiyat</th><th>Toplam</th></tr></thead>
        <tbody>
          <% items.forEach(i => { %>
          <tr>
            <td><%= i.product_name %></td>
            <td><%= i.quantity %></td>
            <td><%= i.price.toFixed(2) %> ₺</td>
            <td><%= (i.price * i.quantity).toFixed(2) %> ₺</td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </main>
  </div>
</body>
</html>
