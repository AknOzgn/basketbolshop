# === BU DOSYAYI .env OLARAK KOPYALAYIP KENDİ BİLGİLERİNİZİ GİRİN ===
# cp .env.example .env

# Site ayarları
PORT=3000
SESSION_SECRET=degistirin-bu-cok-gizli-bir-anahtar-olmali

# Admin paneli giriş bilgileri (ilk kurulumda kullanılır)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ==== ÖDEME BİLGİLERİ (SİZİN DOLDURMANIZ GEREKEN KISIM) ====

# Havale/EFT ile ödeme seçeneği için IBAN bilgileriniz
# (Müşteriler siparişi "Havale/EFT" seçerse bu bilgiler ekranda gösterilir)
BANK_IBAN=TR00 0000 0000 0000 0000 0000 00
BANK_ACCOUNT_HOLDER=Ad Soyad / Firma Ünvanı
BANK_NAME=Banka Adı

# Kredi kartı ile online ödeme için iyzico bilgileriniz
# iyzico.com üzerinden üye işyeri hesabı açtıktan sonra
# "Ayarlar > API Anahtarları" bölümünden alabilirsiniz.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Test ortamı: https://sandbox-api.iyzipay.com
# Canlı ortam:  https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
